[Unit]
Description=Stay dark and charge when the tablet was started by its charger (Lenovo tablets)
ConditionFirmware=|device-tree-compatible(lenovo,tb321fu)
ConditionFirmware=|device-tree-compatible(xiaomi,alioth)
ConditionFirmware=|device-tree-compatible(lenovo,elden)
ConditionFirmware=|device-tree-compatible(lenovo,baldur)
After=systemd-udev-settle.service local-fs.target alioth-game-tune.service steamos-arm-power.service
Before=display-manager.service
RefuseManualStop=yes

[Service]
KillMode=none
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=infinity
ExecStart=/usr/lib/steamos-arm/tablet-charger-hold

[Install]
WantedBy=multi-user.target
