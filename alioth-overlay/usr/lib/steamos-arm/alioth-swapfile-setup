#!/bin/sh
# Create the 2 GiB alioth swap file once, then leave it alone.
#
# Normally the file is /swapfile on the root filesystem, after the 3.5 GiB
# zram (swapfile priority 50, zram priority 100). After the opt-in migration
# /swapfile is a symlink to /var/lib/steamos-extra/swapfile, which lives on
# the Android system partition. If that symlink exists but its filesystem is
# not mounted, fail closed: creating a regular file there would silently put
# the swap back on the root filesystem and hide a mount failure.
set -eu
BASE=/swapfile
EXTRA=/var/lib/steamos-extra
SIZE_MB=2048

if [ -L "$BASE" ]; then
    if ! mountpoint -q "$EXTRA"; then
        echo "alioth-swapfile-setup: $BASE points into $EXTRA but it is not mounted; refusing to create a swap file on the root filesystem" >&2
        exit 1
    fi
    FILE="$EXTRA/swapfile"
else
    FILE="$BASE"
fi

if [ ! -e "$FILE" ]; then
    fallocate -l "${SIZE_MB}M" "$FILE" 2>/dev/null \
        || dd if=/dev/zero of="$FILE" bs=1M count="$SIZE_MB" status=none
fi
chmod 600 "$FILE"

if ! blkid -p -s TYPE -o value "$FILE" 2>/dev/null | grep -qx swap; then
    mkswap "$FILE" >/dev/null
fi
