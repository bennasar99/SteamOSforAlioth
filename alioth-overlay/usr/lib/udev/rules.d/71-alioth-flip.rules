# Razer Kishi only: touch calibration for the 180-degree panel flip in
# 99-orientation.conf.
#
# 70-alioth.rules maps raw touch (nx, ny) to the unmodified landscape frame as
# (ny, 1 - nx). The Kishi-flipped frame is that result rotated 180 degrees, so
# the new mapping is (1 - ny, nx). Keep this in a separate, higher-numbered
# file so removing the Kishi flip only means removing this file.
#
# Install or remove this file together with 99-orientation.conf. Without a
# Razer Kishi, remove both and keep 70-alioth.rules; otherwise picture or
# touch will be rotated 180 degrees.
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="Focaltech FT8756 Touchscreen", \
  ENV{ID_INPUT}="1", ENV{ID_INPUT_TOUCHSCREEN}="1", TAG+="seat", TAG+="uaccess", \
  ENV{LIBINPUT_CALIBRATION_MATRIX}="0 -1 1 1 0 0"
